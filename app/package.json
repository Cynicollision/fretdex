{
    "name": "fretdex",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "imports": {
        "#lib": "./src/lib/index.ts",
        "#lib/*": "./src/lib/*"
    },
    "scripts": {
        "dev": "vite dev",
        "build": "vite build",
        "preview": "vite preview",
        "prepare": "svelte-kit sync || echo ''",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:e2e": "playwright test"
    },
    "dependencies": {
        "@fretdex/audio": "*",
        "@fretdex/fretkit": "*"
    },
    "devDependencies": {
        "@playwright/test": "^1.65.1",
        "@sveltejs/adapter-static": "^4.0.1",
        "@sveltejs/kit": "^3.4.0",
        "@sveltejs/vite-plugin-svelte": "^7.3.2",
        "@types/node": "^24",
        "@vite-pwa/sveltekit": "^2.0.4",
        "@vitest/browser-playwright": "^5.1.1",
        "magicast": "^0.5.5",
        "playwright": "^1.65.1",
        "svelte": "^5.59.1",
        "svelte-check": "^4.7.8",
        "vite": "^8.3.8",
        "vitest-browser-svelte": "^3.1.0"
    }
}
